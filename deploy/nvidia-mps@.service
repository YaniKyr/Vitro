# /etc/systemd/system/nvidia-mps@.service
# One MPS control daemon per GPU; instance name = GPU index (e.g. nvidia-mps@0).
[Unit]
Description=NVIDIA MPS control daemon for GPU %i
After=nvidia-persistenced.service

[Service]
Type=forking
Environment=CUDA_VISIBLE_DEVICES=%i
Environment=CUDA_MPS_PIPE_DIRECTORY=/var/run/nvidia-mps/gpu%i
Environment=CUDA_MPS_LOG_DIRECTORY=/var/log/nvidia-mps/gpu%i
ExecStartPre=/bin/mkdir -p /var/run/nvidia-mps/gpu%i /var/log/nvidia-mps/gpu%i
ExecStart=/usr/bin/nvidia-cuda-mps-control -d
ExecStop=/bin/sh -c 'echo quit | /usr/bin/nvidia-cuda-mps-control'
Restart=on-failure

[Install]
WantedBy=multi-user.target
